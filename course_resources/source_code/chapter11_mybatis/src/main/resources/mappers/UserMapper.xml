<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.dao.UserMapper">
    <select id="getUserById" parameterType="int"
            resultMap="userOrdersResultMap">
        SELECT
            u.user_id AS id,
            u.user_name AS name,
            o.order_id AS orderId,
            o.user_id AS userId,
            o.price
        FROM t_user u
                 JOIN t_order o ON u.user_id = o.user_id
        WHERE u.user_id = #{id}
    </select>
    <!-- User和Order的结果映射 -->
    <resultMap id="userOrdersResultMap" type="com.itheima.model.User">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <collection property="orders" ofType="com.itheima.model.Order"
                    resultMap="OrderResultMap"/>
    </resultMap>
    <!-- Order的结果映射 -->
    <resultMap id="OrderResultMap" type="com.itheima.model.Order">
        <id property="orderId" column="orderId"/>
        <result property="userId" column="userId"/>
        <result property="price" column="price"/>
    </resultMap>
</mapper>